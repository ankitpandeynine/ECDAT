# Export these variables in the process environment; Python does not auto-load this file.
# Use an absolute persistent-disk path on Render if SQLite is used.
ECDAT_DB=/var/data/scans.sqlite3
# Optional bearer token. If set, configure the same value as ECDAT_API_TOKEN in the Vercel project.
ECDAT_API_TOKEN=
ECDAT_ALLOWED_CIDRS=
# Comma-separated exact origins for direct browser access (proxy-based Vercel UI normally needs no CORS entry).
CORS_ORIGINS=http://localhost:3000
HOST=0.0.0.0
PORT=8000
